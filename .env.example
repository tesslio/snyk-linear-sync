SNYK_REGION=SNYK-US-01
SNYK_CLIENT_ID=
SNYK_CLIENT_SECRET=
SNYK_ORG_ID=
SNYK_OAUTH_SCOPES=
SOURCE_PROVIDER=unknown
CACHE_DB_FILE=data/snyk-linear-sync-cache.db
ERROR_LOG_FILE=logs/snyk-linear-sync-errors.log

LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_STATE_TODO=Triage
LINEAR_STATE_BACKLOG=Backlog
LINEAR_STATE_DONE=Done
LINEAR_STATE_CANCELLED=Cancelled
LINEAR_UNSUBSCRIBE_ACTOR=true
LINEAR_COMMENTS=false
LINEAR_MANAGED_LABEL=snyk-automation
LINEAR_TOOL_LABELS=code:snyk-code,package_vulnerability:snyk-open-source,license:snyk-license,cloud:snyk-cloud,config:snyk-config,custom:snyk-custom
LINEAR_TOOL_LABEL_DEFAULT=off
LINEAR_ORIGIN_LABELS=github:snyk-github,kubernetes:snyk-kubernetes
LINEAR_ORIGIN_LABEL_DEFAULT=off
LINEAR_AWAITING_FIX_LABEL=no-fix-available
# Labels stamped once, on issue creation, and never reconciled afterwards.
# Use for a routing label a downstream consumer owns from then on.
LINEAR_CREATE_ONLY_LABELS=
# Labels this sync must never add to, or remove from, an existing issue.
# Defaults to the kikimora Dark Factory control labels; set to "off" to disable.
LINEAR_PROTECTED_LABELS=df:kikimora-snyk,df:kikimora-snyk-complete,df:kikimora-snyk-invalid
LINEAR_DUE_DAYS_CRITICAL=15
LINEAR_DUE_DAYS_HIGH=30
LINEAR_DUE_DAYS_MEDIUM=45
LINEAR_DUE_DAYS_LOW=90

# Lookback window (in days) for including auto-archived Linear tickets in the
# sync snapshot. Should be >= your team's auto-archive period. Default: 35 (5 weeks).
LINEAR_ARCHIVE_LOOKBACK_DAYS=35

SYNC_WORKERS=16
SNYK_HTTP_CONCURRENCY=6
LINEAR_HTTP_CONCURRENCY=8
